{
  "manifest_version": 3,
  "name": "Favicon 获取器",
  "version": "1.1.0",
  "description": "一键获取并下载任意网站的 favicon 图标。自动解析标签页图标、HTML link 标签、favicon.ico 及 Google 回退服务。",
  "permissions": ["activeTab", "scripting", "downloads", "clipboardWrite"
  ],
  "host_permissions": [
    "*://*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "获取当前网站的 favicon",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
